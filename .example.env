# Copy to .env.local. Read by `npm start` (src/server.mjs); what the shell sets wins.

# The XO root, as xo-space calls it: every folder in it is an app at <folder>.localhost:PORT.
XO_PROJECTS_ROOT=~/xo-projects

# Where galileo listens, on 127.0.0.1 only.
PORT=4100

# Where comments, captures, toolbar designs and added apps are kept. Default data/.
# XO_GATEWAY_DATA=data

# Another xo-toolbar checkout. Default: the installed package, else ../xo-toolbar.
# XO_TOOLBAR_DIR=../xo-toolbar
